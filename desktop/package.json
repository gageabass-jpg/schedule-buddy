{
  "name": "nucleus-manager",
  "version": "0.1.0",
  "description": "Nucleus Manager — desktop companion to the iOS Nucleus app",
  "author": "Gage Bass",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:wvu": "node --input-type=commonjs -e \"const fs=require('fs');fs.copyFileSync('../public/wvu-football.json','public/wvu-football.json');fs.copyFileSync('../public/assets/wvu.png','public/assets/wvu.png');console.log('synced WVU schedule + logo from ../public')\"",
    "dev": "concurrently -k -s first -n vite,electron \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .\"",
    "prebuild:web": "npm run sync:wvu",
    "build:web": "tsc -p tsconfig.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:web && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gagebass.schedulebuddy.manager",
    "productName": "Nucleus Manager",
    "copyright": "Copyright © 2026 Gage Bass",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Nucleus Manager",
      "iconSize": 96,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon-dark.png",
        "to": "icon-dark.png"
      }
    ]
  }
}
