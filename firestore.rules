rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Household document
    match /households/{householdId} {
      // Create: user must be in the new doc's memberUids
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;
      // Read: any authenticated member
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      // Update: existing members OR someone adding themselves (joining via invite code)
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);
      // Delete: only existing members
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
    }

    // Schedule state — scoped to household, only members
    match /households/{householdId}/state/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // OT approvals — scoped to household
    match /households/{householdId}/otApprovals/{approvalId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Feedback messages
    match /households/{householdId}/feedback/{msgId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Invite codes — authenticated users can read (to join) and create (during household setup)
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
