rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Household document — who is in it and in what role.
    //
    // These writes happen to it, and only these are allowed:
    //   create — the creator alone, as admin;
    //   join   — someone adds only themselves, naming a real invite code for
    //            THIS household, in the role the code grants (never admin);
    //   leave  — a member removes only themselves (leave, delete account);
    //   info   — admin or partner changes the household's name, time zone or
    //            childcare flag, and nothing else.
    // An admin may otherwise change it (remove members, change roles). Nothing
    // deletes a household.
    match /households/{householdId} {
      allow create: if request.auth != null
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'admin'
        && request.resource.data.createdBy == request.auth.uid;
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow update: if request.auth != null
        && (isHouseholdAdmin() || isLeavingSelf() || isJoiningWithCode() || isEditingInfo());
      allow delete: if false;

      function isHouseholdAdmin() {
        return resource.data.roles.get(request.auth.uid, '') == 'admin';
      }
      // Only these fields change, and within the two maps only the caller's key.
      function onlySelfMembership() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'memberNames', 'roles', 'joinCode'])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys()
            .hasOnly([request.auth.uid])
          && request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys()
            .hasOnly([request.auth.uid]);
      }
      function isEditingInfo() {
        return resource.data.roles.get(request.auth.uid, '') == 'partner'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'timeZone', 'childcare']);
      }
      function isLeavingSelf() {
        return request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
          && !(request.auth.uid in request.resource.data.roles)
          && onlySelfMembership();
      }
      function isJoiningWithCode() {
        let code = request.resource.data.get('joinCode', '');
        let invite = get(/databases/$(database)/documents/inviteCodes/$(code)).data;
        let role = request.resource.data.roles[request.auth.uid];
        return !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && onlySelfMembership()
          && code is string && code.size() == 6
          && exists(/databases/$(database)/documents/inviteCodes/$(code))
          && invite.householdId == householdId
          && ((invite.get('role', '') == 'supporting' && role == 'supporting')
            || (invite.get('role', '') != 'supporting' && role == 'partner'));
      }
    }

    // Schedule state — admin and partner only. A caregiver (supporting) sees
    // caregiverView/main instead, and changes things only through the
    // caregiverAction function, which applies one checked change at a time.
    match /households/{householdId}/state/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.roles.get(request.auth.uid, '') in ['admin', 'partner'];
    }

    // ── The any-household model (docs/data-model.md, shared/store.ts) ──────
    // One document per record, so access is per record: admin and partner
    // read and write everything; a caregiver reads who's who, the shift
    // types, and only what is theirs — their details, their shifts, their
    // days off, the coverage requests addressed to them, the requests they
    // sent. A caregiver writes nothing directly; their changes go through
    // the caregiverAction function. Not yet used by any client.
    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function isHouseholdMember(hid) {
      return request.auth != null && request.auth.uid in householdData(hid).memberUids;
    }
    function isHouseholdManager(hid) {
      return request.auth != null
        && householdData(hid).roles.get(request.auth.uid, '') in ['admin', 'partner'];
    }
    // The caller is this person (their people/ record names the caller's account).
    function isPerson(hid, pid) {
      return request.auth != null
        && get(/databases/$(database)/documents/households/$(hid)/people/$(pid)).data.get('uid', '') == request.auth.uid;
    }

    match /households/{hid}/people/{pid} {
      allow read: if isHouseholdMember(hid);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/personDetails/{pid} {
      allow read: if isHouseholdManager(hid) || isPerson(hid, pid);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/shiftTypes/{id} {
      allow read: if isHouseholdMember(hid);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/shifts/{id} {
      allow read: if isHouseholdManager(hid) || isPerson(hid, resource.data.personId);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/caregiverOff/{id} {
      allow read: if isHouseholdManager(hid) || isPerson(hid, resource.data.personId);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/coverageRequests/{id} {
      allow read: if isHouseholdManager(hid) || isPerson(hid, resource.data.caregiverId);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/caregiverRequests/{id} {
      allow read: if isHouseholdManager(hid)
        || (isHouseholdMember(hid) && resource.data.createdBy == request.auth.uid);
      allow write: if isHouseholdManager(hid);
    }
    match /households/{hid}/events/{id} {
      allow read, write: if isHouseholdManager(hid);
    }
    match /households/{hid}/scheduleBlocks/{id} {
      allow read, write: if isHouseholdManager(hid);
    }
    match /households/{hid}/occasions/{id} {
      allow read, write: if isHouseholdManager(hid);
    }
    match /households/{hid}/shiftOffers/{id} {
      allow read, write: if isHouseholdManager(hid);
    }
    match /households/{hid}/imports/{id} {
      allow read, write: if isHouseholdManager(hid);
    }
    match /households/{hid}/settings/{docId} {
      allow read, write: if isHouseholdManager(hid);
    }
    // The edit log: one entry per save, naming who made it. The onHouseholdEdit
    // function sends the notifications for it and removes it.
    match /households/{hid}/edits/{editId} {
      allow read: if isHouseholdManager(hid);
      allow create: if isHouseholdManager(hid) && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // The caregiver's slice of the schedule: coverage requests and names.
    // Written only by the mirrorCaregiverView / caregiverAction functions.
    match /households/{householdId}/caregiverView/{docId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow write: if false;
    }

    // OT approvals — scoped to household
    match /households/{householdId}/otApprovals/{approvalId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.roles.get(request.auth.uid, '') in ['admin', 'partner'];
    }

    // Feedback messages
    match /households/{householdId}/feedback/{msgId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Invite codes — authenticated users can read (to join) and create (during household setup)
    // Invite codes: look one up by its code, never list them. A list would
    // hand every household id to anyone signed in (and with it, the join rule
    // above). Clients only ever get a code by id.
    // Only an admin or partner of the household may mint a code for it, and a
    // code grants partner ("contributing", or no role) or supporting — never admin.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.householdId is string
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId))
             .data.roles.get(request.auth.uid, '') in ['admin', 'partner']
        && request.resource.data.get('role', 'contributing') in ['contributing', 'supporting'];
    }

    // Push notification tokens — one doc per user per household, doc id = uid.
    // Members can read everyone's row (so the desktop can show "Daisy is
    // reachable"). Writes are gated to self — Cloud Functions use the
    // Admin SDK and bypass these rules anyway.
    match /households/{householdId}/pushTokens/{tokenDocId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create, update, delete: if request.auth != null
        && tokenDocId == request.auth.uid;
    }

    // Family chat — one doc per message. Any member can read; only the
    // sender can create their own (senderId pinned to uid) and only the
    // sender can delete. Messages are immutable once posted.
    //
    // Manager-only fields: fromManager / toUids drive "sent as Manager"
    // rendering, targeted visibility, and the generic push. Every client and
    // the push function trust them, so only manager roles (admin / partner)
    // may write them — and only managers may claim the name "Manager".
    // Without this, a supporting member could impersonate the Manager with
    // messages targeted to be invisible to the real managers.
    match /households/{householdId}/chat/{messageId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.senderId == request.auth.uid
        && (
          (
            !request.resource.data.keys().hasAny(['fromManager', 'toUids'])
            && request.resource.data.senderName != 'Manager'
          )
          || get(/databases/$(database)/documents/households/$(householdId)).data.roles[request.auth.uid] in ['admin', 'partner']
        );
      allow delete: if request.auth != null
        && resource.data.senderId == request.auth.uid;
      allow update: if false;
    }

    // Per-user read-state — when each member last opened the chat. Used
    // to compute unread badges. Doc id = uid, writeable only by self,
    // readable by any member.
    // Notification history — written by Cloud Functions only (recordNotification
    // in functions/src/index.ts). Members read them and may mark one read or
    // unread for themselves: an update can change nothing but readBy, and only
    // their own key in it.
    match /households/{householdId}/notifications/{notificationId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Day flags — one doc per flagged day ({date} = YYYY-MM-DD). Any member
    // can flag, edit or clear a day; remarks are capped at 1000 characters and
    // a write must name its author as the signed-in user.
    match /households/{householdId}/dayFlags/{date} {
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.flaggedBy == request.auth.uid
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() <= 1000;
    }

    match /households/{householdId}/chatRead/{uid} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create, update, delete: if request.auth != null
        && uid == request.auth.uid;
    }

    // Wall display photos — metadata only (the bytes live in Firebase
    // Storage at wallPhotos/{hid}/{photoId}). Each doc records the
    // persistent download URL + uploader + createdAt. The getWallState
    // Cloud Function reads these to build the wall's photo rotation.
    match /households/{householdId}/wallPhotos/{photoId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Commute settings — private/commute holds the home address and each
    // person's workplace (Google place ids). Admin and partner only: not the
    // caregiver account, and never mirrored into state/main or the share.
    match /households/{householdId}/private/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.roles[request.auth.uid] in ['admin', 'partner'];
    }

    // "Leave by" results, one doc per shift ({date}_{who}), written only by
    // the checkCommutes function (Admin SDK). Admin and partner may read.
    match /households/{householdId}/commute/{docId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.roles[request.auth.uid] in ['admin', 'partner'];
      allow write: if false;
    }

    // Per-household meta docs written by Cloud Functions (Admin SDK, bypasses
    // rules) and read/updated by clients. Currently: meta/cadence (the
    // 4-week schedule reminder flag + the desktop's per-cycle dismissals) and
    // meta/piCommand (wall remote). Any member may read and write — the flags
    // are non-sensitive household state and the desktop records dismissals here.
    match /households/{householdId}/meta/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Wall message board — the note shown on the wall display's board card.
    // Any member (including supporting caregivers) may post; the wall renders
    // the most recent unexpired one. senderId is pinned to the caller's uid so
    // a post can't be attributed to someone else, and messages are immutable
    // once written. Anyone in the household may delete — the board is shared
    // and a stale or unwanted note needs to be clearable from any device, not
    // just the poster's. The getWallState function reads these with the Admin
    // SDK (bypasses rules) to build the wall payload.
    match /households/{householdId}/wallMessages/{messageId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.senderId == request.auth.uid;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow update: if false;
    }

    // Wall display tokens. Top-level so the getWallState HTTPS function
    // can look up a token without knowing the household. Each doc points
    // at a householdId; only members of that household can create/list/
    // revoke. The token itself is the document id (a long random string)
    // so a leaked URL only exposes one household's read-only dashboard.
    //
    // The wall page never reads Firestore directly — it calls getWallState
    // (Admin SDK, bypasses rules). So no public read needed here.
    match /wallTokens/{token} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Read-only public share snapshot. A SANITIZED calendar (shifts + event
    // titles only — no emails, chat, coverage, health, pay, or account data),
    // keyed by a long random token. World-readable by token (that's the point:
    // the guest link at share.html and the /ics feed both read it). Only the
    // authenticated member who created it — stamping their own uid as ownerUid
    // — may write or delete it. Revoking = deleting the doc + rotating token.
    match /publicShares/{token} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
