rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Household document
    match /households/{householdId} {
      // Create: user must be in the new doc's memberUids
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;
      // Read: any authenticated member
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      // Update: existing members OR someone adding themselves (joining via invite code)
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);
      // Delete: only existing members
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
    }

    // Schedule state — scoped to household, only members
    match /households/{householdId}/state/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // OT approvals — scoped to household
    match /households/{householdId}/otApprovals/{approvalId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Feedback messages
    match /households/{householdId}/feedback/{msgId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Invite codes — authenticated users can read (to join) and create (during household setup)
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Push notification tokens — one doc per user per household, doc id = uid.
    // Members can read everyone's row (so the desktop can show "Daisy is
    // reachable"). Writes are gated to self — Cloud Functions use the
    // Admin SDK and bypass these rules anyway.
    match /households/{householdId}/pushTokens/{tokenDocId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create, update, delete: if request.auth != null
        && tokenDocId == request.auth.uid;
    }

    // Family chat — one doc per message. Any member can read; only the
    // sender can create their own (senderId pinned to uid) and only the
    // sender can delete. Messages are immutable once posted.
    //
    // Manager-only fields: fromManager / toUids drive "sent as Manager"
    // rendering, targeted visibility, and the generic push. Every client and
    // the push function trust them, so only manager roles (admin / partner)
    // may write them — and only managers may claim the name "Manager".
    // Without this, a supporting member could impersonate the Manager with
    // messages targeted to be invisible to the real managers.
    match /households/{householdId}/chat/{messageId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.senderId == request.auth.uid
        && (
          (
            !request.resource.data.keys().hasAny(['fromManager', 'toUids'])
            && request.resource.data.senderName != 'Manager'
          )
          || get(/databases/$(database)/documents/households/$(householdId)).data.roles[request.auth.uid] in ['admin', 'partner']
        );
      allow delete: if request.auth != null
        && resource.data.senderId == request.auth.uid;
      allow update: if false;
    }

    // Per-user read-state — when each member last opened the chat. Used
    // to compute unread badges. Doc id = uid, writeable only by self,
    // readable by any member.
    // Day flags — one doc per flagged day ({date} = YYYY-MM-DD). Any member
    // can flag, edit or clear a day; remarks are capped at 1000 characters and
    // a write must name its author as the signed-in user.
    match /households/{householdId}/dayFlags/{date} {
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.flaggedBy == request.auth.uid
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() <= 1000;
    }

    match /households/{householdId}/chatRead/{uid} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create, update, delete: if request.auth != null
        && uid == request.auth.uid;
    }

    // Wall display photos — metadata only (the bytes live in Firebase
    // Storage at wallPhotos/{hid}/{photoId}). Each doc records the
    // persistent download URL + uploader + createdAt. The getWallState
    // Cloud Function reads these to build the wall's photo rotation.
    match /households/{householdId}/wallPhotos/{photoId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Per-household meta docs written by Cloud Functions (Admin SDK, bypasses
    // rules) and read/updated by clients. Currently: meta/cadence (the
    // 4-week schedule reminder flag + the desktop's per-cycle dismissals) and
    // meta/piCommand (wall remote). Any member may read and write — the flags
    // are non-sensitive household state and the desktop records dismissals here.
    match /households/{householdId}/meta/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Wall message board — the note shown on the wall display's board card.
    // Any member (including supporting caregivers) may post; the wall renders
    // the most recent unexpired one. senderId is pinned to the caller's uid so
    // a post can't be attributed to someone else, and messages are immutable
    // once written. Anyone in the household may delete — the board is shared
    // and a stale or unwanted note needs to be clearable from any device, not
    // just the poster's. The getWallState function reads these with the Admin
    // SDK (bypasses rules) to build the wall payload.
    match /households/{householdId}/wallMessages/{messageId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.senderId == request.auth.uid;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow update: if false;
    }

    // Wall display tokens. Top-level so the getWallState HTTPS function
    // can look up a token without knowing the household. Each doc points
    // at a householdId; only members of that household can create/list/
    // revoke. The token itself is the document id (a long random string)
    // so a leaked URL only exposes one household's read-only dashboard.
    //
    // The wall page never reads Firestore directly — it calls getWallState
    // (Admin SDK, bypasses rules). So no public read needed here.
    match /wallTokens/{token} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Read-only public share snapshot. A SANITIZED calendar (shifts + event
    // titles only — no emails, chat, coverage, health, pay, or account data),
    // keyed by a long random token. World-readable by token (that's the point:
    // the guest link at share.html and the /ics feed both read it). Only the
    // authenticated member who created it — stamping their own uid as ownerUid
    // — may write or delete it. Revoking = deleting the doc + rotating token.
    match /publicShares/{token} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
