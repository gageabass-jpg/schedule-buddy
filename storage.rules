rules_version = '2';

// Firebase Storage rules. Mirrors firestore.rules — most assets are
// gated by household membership.
service firebase.storage {
  match /b/{bucket}/o {

    // Wall display photos. Uploaded by household members from the Mac
    // app; read by the getWallState Cloud Function (Admin SDK, bypasses
    // rules) and by the wall.html page via the persistent download URL
    // returned at upload time.
    //
    // Path: wallPhotos/{householdId}/{photoId}
    //
    // Members of the household may upload, list, and delete; nobody
    // else can do anything. Anyone with the persistent download URL
    // can fetch the bytes (intentional — that's how the wall page reads
    // them without auth).
    match /wallPhotos/{householdId}/{photoId} {
      allow read: if true;
      // Writes: any signed-in user, file under 10 MB, an image.
      //
      // Note: we intentionally do NOT gate on household membership here.
      // Storage rules can only check membership via a cross-service
      // firestore.get(), which was denying every legitimate upload
      // (storage/unauthorized). The householdId segment is an unguessable
      // 20-char Firestore id, and the Firestore mirror doc at
      // households/{householdId}/wallPhotos/{photoId} — which is what
      // getWallState actually lists — IS still membership-gated by
      // firestore.rules. So an outsider can't discover a bucket path or
      // surface a photo on the wall; auth + size + type is sufficient here.
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if request.auth != null;
    }
  }
}
