rules_version = '2';

// Firebase Storage rules. Mirrors firestore.rules — most assets are
// gated by household membership.
service firebase.storage {
  match /b/{bucket}/o {

    // Is the caller a member of this household? Storage can't see Firestore
    // on its own: this is a cross-service rule. Two things it needs:
    //  - the Firestore path is written with (default), as the Firebase docs
    //    show for Storage rules; there is no {database} wildcard here as
    //    there is in firestore.rules;
    //  - the Firebase Storage service agent needs the IAM role
    //    "Firebase Rules Firestore Service Agent" (roles/firebaserules.
    //    firestoreServiceAgent) on the project. `firebase deploy --only
    //    storage` offers to grant it, but only when run interactively
    //    (not in CI, not with --non-interactive) and only when the rules
    //    text changed. Without the role every check here denies, and so
    //    does every upload: a membership check removed once for exactly
    //    that symptom (storage/unauthorized).
    function isMember(householdId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/households/$(householdId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberUids;
    }

    // Wall display photos. Uploaded by household members from the Mac app.
    // The wall page and getWallState never read this path through the rules:
    // getWallState lists the Firestore mirror (households/{hid}/wallPhotos)
    // with the Admin SDK, and the wall page loads each photo from the
    // persistent download URL stored there. A download URL carries its own
    // token and bypasses these rules — it is the capability that lets an
    // unauthenticated Pi show the photo, and it stays valid.
    //
    // Path: wallPhotos/{householdId}/{photoId}
    //
    // Only members of the household touch the objects directly: get (the
    // uploader's getDownloadURL needs it), upload, replace, delete. Nobody
    // lists the folder: with the household id (which a guest-share link,
    // an invite code, or a household member's own client can reveal) a list
    // would hand out every photo's path. The photoId is 16 random characters.
    match /wallPhotos/{householdId}/{photoId} {
      allow get: if isMember(householdId);
      allow list: if false;
      allow create, update: if isMember(householdId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if isMember(householdId);
    }
  }
}
